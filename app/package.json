{
  "name": "vexnar-app",
  "private": true,
  "version": "0.1.0",
  "description": "VEXNAR client workspace and isolated runtime",
  "author": "xuzhongxin <xuzhongxin@sec.hn.cn> (https://github.com/zhongxinxuhk/VEXNAR)",
  "repository": "https://github.com/zhongxinxuhk/VEXNAR",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/vexnar.mjs setup",
    "web": "node scripts/vexnar.mjs web",
    "desktop": "node scripts/vexnar.mjs desktop",
    "go:build": "node scripts/vexnar-go.mjs build",
    "go:stamp": "node scripts/vexnar-go.mjs stamp",
    "build": "pnpm --filter @vexnar/dsh-ui --filter @vexnar/dsh-account run build",
    "typecheck": "pnpm --filter @vexnar/dsh-ui --filter @vexnar/dsh-account --filter @vexnar/core run typecheck",
    "ui:build": "pnpm --filter @vexnar/dsh-ui run build",
    "account:build": "pnpm --filter @vexnar/dsh-account run build",
    "upstream:check": "node scripts/check-upstream.mjs",
    "upstream:upgrade": "node scripts/upgrade-dsh.mjs",
    "craft:check": "node scripts/craft-update.mjs --check",
    "craft:update": "node scripts/craft-update.mjs",
    "shop:check": "node scripts/shop-update.mjs --check",
    "shop:update": "node scripts/shop-update.mjs",
    "vexnar": "node scripts/vexnar.mjs",
    "migrate:store": "node scripts/migrate-store.mjs",
    "catalog:gen": "node scripts/gen-catalog-defaults.mjs",
    "test:catalog": "node --test vexnar-core/test/catalog-register.test.ts"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.2-rc.5",
    "electron": "44.7.0",
    "zod": "4.6.7"
  },
  "bin": {
    "vexnar": "./scripts/vexnar.mjs"
  }
}
