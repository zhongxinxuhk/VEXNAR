  "license": "AGPL-3.0-or-later",
  "scripts": {
    "setup": "node scripts/setup-app-profile.mjs",
    "web": "node scripts/dsh-web.mjs --no-open --port 3099",
    "desktop": "node scripts/dsh-desktop.mjs",
    "ui:build": "npm --prefix vexnar/ui run build",
