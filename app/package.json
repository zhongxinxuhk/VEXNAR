{
  "name": "vexnar-app",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "VEXNAR client workspace and isolated runtime",
  "author": "xuzhongxin <xuzhongxin@sec.hn.cn> (https://github.com/zhongxinxuhk/VEXNAR)",
  "repository": "https://github.com/zhongxinxuhk/VEXNAR",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "tsx scripts/vexnar.ts setup",
    "web": "tsx scripts/vexnar.ts web",
    "desktop": "tsx scripts/vexnar.ts desktop",
    "go:build": "tsx scripts/vexnar-go.ts build",
    "go:stamp": "tsx scripts/vexnar-go.ts stamp",
    "build": "pnpm --filter @vexnar/dsh-ui --filter @vexnar/dsh-account --filter @vexnar/dsh-egress run build && pnpm --filter @vexnar/core run build:embedded",
    "typecheck": "pnpm --filter @vexnar/dsh-ui --filter @vexnar/dsh-account --filter @vexnar/dsh-egress --filter @vexnar/core --filter @vexnar/web run typecheck",
    "ui:build": "pnpm --filter @vexnar/dsh-ui run build",
    "account:build": "pnpm --filter @vexnar/dsh-account run build",
    "upstream:check": "tsx scripts/check-upstream.ts",
    "upstream:upgrade": "tsx scripts/upgrade-dsh.ts",
    "craft:check": "tsx scripts/craft-update.ts --check",
    "craft:update": "tsx scripts/craft-update.ts",
    "shop:check": "tsx scripts/shop-update.ts --check",
    "shop:update": "tsx scripts/shop-update.ts",
    "vexnar": "tsx scripts/vexnar.ts",
    "migrate:store": "tsx scripts/migrate-store.ts",
    "catalog:gen": "tsx scripts/gen-catalog-defaults.ts",
    "test:catalog": "tsx --test vexnar-core/test/catalog-register.test.ts",
    "test:profile": "tsx --test scripts/profile-migration.test.ts",
    "test:web": "pnpm --filter @vexnar/web run test",
    "web:mcp": "pnpm --filter @vexnar/web run mcp",
    "plugins:check": "tsx scripts/plugin-inventory.ts",
    "check:data": "tsx scripts/check-tracked-data.ts",
    "test:preset": "tsx --test scripts/vexnar-extras.test.ts scripts/plugin-inventory.test.ts"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.2-rc.5",
    "@types/node": "^26.6.6",
    "electron": "44.7.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "zod": "4.6.7"
  },
  "bin": {
    "vexnar": "./scripts/vexnar.ts"
  }
}
