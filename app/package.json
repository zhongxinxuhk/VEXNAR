{
  "name": "vexnar-app",
  "private": true,
  "version": "0.1.0",
  "description": "VEXNAR app workspace: dsh web/desktop launchers and client UI",
  "author": "xuzhongxin <xuzhongxin@sec.hn.cn> (https://github.com/zhongxinxuhk/VEXNAR)",
  "repository": "https://github.com/zhongxinxuhk/VEXNAR",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup-app-profile.mjs",
    "web": "node scripts/dsh-web.mjs --no-open --port 3099",
    "desktop": "node scripts/dsh-desktop.mjs",
    "build": "pnpm --filter @vexnar/dsh-ui --filter @vexnar/dsh-account run build",
    "typecheck": "pnpm --filter @vexnar/dsh-ui --filter @vexnar/dsh-account run typecheck",
    "ui:build": "pnpm --filter @vexnar/dsh-ui run build",
    "account:build": "pnpm --filter @vexnar/dsh-account run build",
    "upstream:check": "node scripts/check-upstream.mjs",
    "upstream:upgrade": "node scripts/upgrade-dsh.mjs",
    "craft:check": "node scripts/craft-update.mjs --check",
    "craft:update": "node scripts/craft-update.mjs",
    "shop:check": "node scripts/shop-update.mjs --check",
    "shop:update": "node scripts/shop-update.mjs"
  }
}
