{
  "name": "@vexnar/dsh-account",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VEXNAR account section for the dsh web client: NewAPI login through the Go desktop gateway",
  "author": "xuzhongxin <xuzhongxin@sec.hn.cn> (https://github.com/zhongxinxuhk/VEXNAR)",
  "repository": "https://github.com/zhongxinxuhk/VEXNAR",
  "license": "AGPL-3.0-or-later",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node build.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "playwright-core": "^1.65.1"
  }
}
