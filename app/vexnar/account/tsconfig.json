/**
 * Type-check only. The client bundle is produced by build.ts (esbuild), which
 * strips types and keeps the platform modules external; `tsc` never emits here.
 *
 * React is not a dependency of this package: at runtime the dsh client module
 * loader supplies it, and esbuild lists it as external. Only its type
 * declarations are needed locally, so `@types/react` is a devDependency.
 */
{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    // lib/ 下的插件源码由 dsh 运行时直接 import（类型擦除），import 写真实 .ts 路径
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src"],
  // 宿主插件（node 侧）由 tsconfig.node.json 负责；这里只剩浏览器代码。
  "exclude": [
    "src/index.ts",
    "src/platform.ts",
    "src/platform-account.ts",
    "src/login-page.ts",
    "src/model-gateway.ts",
    "src/yak-history-tools.ts",
    "src/yak-history.ts"
  ]
}
