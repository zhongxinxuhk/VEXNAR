{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    // 脚本由 tsx 直接跑，import 写的是真实 .ts 路径
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts", "*.ts"]
}
