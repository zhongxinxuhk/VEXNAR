{
  "name": "@vexnar/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VEXNAR TypeScript core: read-only API slice over the existing PostgreSQL",
  "author": "xuzhongxin <xuzhongxin@sec.hn.cn> (https://github.com/zhongxinxuhk/VEXNAR)",
  "repository": "https://github.com/zhongxinxuhk/VEXNAR",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "compare": "tsx compare.ts",
    "compare:domain": "tsx compare-domain.ts",
    "verify": "tsx verify.ts",
    "build:embedded": "tsx build-embedded.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test *.test.ts",
    "test:traffic-index": "tsx traffic-index.test.ts",
    "test:egress": "tsx egress.test.ts && tsx egress-routes.test.ts",
    "test:bridge": "tsx proxy-bridge.test.ts",
    "fetch:mihomo": "tsx ../scripts/fetch-mihomo.ts",
    "test:traffic-index": "tsx traffic-index.test.ts",
    "test:egress": "tsx egress.test.ts && tsx egress-routes.test.ts",
    "test:bridge": "tsx proxy-bridge.test.ts",
    "fetch:mihomo": "tsx ../scripts/fetch-mihomo.ts",
    "test:mitm": "tsx traffic-mitm.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "hono": "^4.10.7",
    "jsonwebtoken": "^9.0.3",
    "kysely": "^0.29.9",
    "node-forge": "^1.4.3",
    "pg": "^8.23.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/node-forge": "^1.3.14",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
