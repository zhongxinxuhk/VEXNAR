dsh/

# Local dsh home used by the GoLand run configurations (profile + sessions).
.dsh-home/

# UI package build inputs/outputs that are reproducible.
vexnar/ui/node_modules/
vexnar/ui/lib/client.cjs
vexnar/account/node_modules/
vexnar/account/lib/client.cjs

# Spike dependencies
spike/**/node_modules/

# Spike node_modules links
app/spike/*/node_modules
spike/*/node_modules

# Workspace dependencies
*/node_modules
