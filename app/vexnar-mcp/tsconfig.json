{
  // dsh 在 Node ≥ 22 的运行时里直接 import 这个包的 index.ts（类型擦除），
  // 所以入口就是 .ts；这里只做类型检查，不产出编译结果。
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["index.ts"]
}
