{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VEXNAR",
  "version": "0.0.1",
  "identifier": "com.vexnar.desktop",
  "build": {
    "frontendDist": "ui",
    "beforeBuildCommand": "bash scripts/prepare-sidecar.sh --release"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "AI 自主渗透测试系统",
    "longDescription": "VEXNAR 桌面客户端：内置本地服务，双击即可使用。",
    "externalBin": [
      "binaries/vexnar"
    ],
    "resources": {
      "resources/pg": "pg"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
