  "license": "AGPL-3.0-or-later",
  "mcp": [
    {
      "name": "filesystem",
      "description": "读写指定目录下的文件。安装时把最后一个参数改成你自己的目录。",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/path/to/workspace"],
      "tags": ["官方", "文件"],
      "homepage": "https://github.com/modelcontextprotocol/servers"
    },
    {
      "name": "memory",
      "description": "基于知识图谱的持久记忆，跨会话保留事实、实体与关系。",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "tags": ["官方", "记忆"],
      "homepage": "https://github.com/modelcontextprotocol/servers"
    },
    {
      "name": "sequential-thinking",
      "description": "可回溯的分步推理草稿，适合复杂排查链路与方案推演。",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
      "tags": ["官方", "推理"],
      "homepage": "https://github.com/modelcontextprotocol/servers"
    },
    {
      "name": "playwright",
