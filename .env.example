# Docker 部署配置（复制为 .env）
VEXNAR_TAG=latest
POSTGRES_USER=vexnar
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=vexnar

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VEXNAR_LLM_PROVIDER=
VEXNAR_LLM_MODEL=
VEXNAR_LLM_BASE_URL=
VEXNAR_LLM_PROXY=
